	<string id="mil_secret_0028_name">
		<text>車子裡的秘密藏匿物</text>
	</string>
	<string id="pri_secret_0000_description">
		<text>據說一些有名的潛行者在這裡歸天了，但沒有人撿到過他們的遺物。</text>
	</string>
	<string id="pri_secret_0000_name">
		<text>死亡潛行者的遺物</text>
	</string>
	<string id="pri_secret_0001_description">
		<text>據說在廢棄區有一個箱子，裡面裝了一堆好東西。</text>
	</string>
	<string id="pri_secret_0001_name">
		<text>廢棄區的寶藏</text>
	</string>
	<string id="pri_secret_0002_description">
